# BookLeaf Publishing - Backend Environment Configuration

# Server Settings
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase PostgreSQL & Auth Credentials
# URL of your Supabase Project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://db.supabase.co
# Service Role key is strictly used on the backend for administrative operations and bypassing RLS when validating tokens
SUPABASE_SERVICE_ROLE_KEY=key
# Supabase Anon / Publishable key
SUPABASE_ANON_KEY=sb_publishable_key
# Optional Supabase JWT secret for offline signature verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Groq Cloud AI Configuration
GROQ_API_KEY=gsk_key
# Currently recommended Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, or mixtral-8x7b-32768
GROQ_MODEL=openai/gpt-oss-120b

# Logging
LOG_LEVEL=INFO
